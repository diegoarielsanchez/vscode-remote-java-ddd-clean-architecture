<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for api-gateway.

  SPRING_CSRF_PROTECTION_DISABLED: CSRF is intentionally disabled.
  This is a stateless gateway — no session cookies are used, so CSRF is not
  applicable. Downstream services enforce their own JWT-based auth.
-->
<FindBugsFilter>
    <Match>
        <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
        <Class name="com.das.gateway.config.SecurityConfig"/>
    </Match>
</FindBugsFilter>
