<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
    </parent>
  
    <groupId>org.springframework.cleanddd</groupId>
    <artifactId>das-clean-ddd</artifactId>
    <version>3.4.1</version>
    <name>${project.artifactId}</name>
    <packaging>pom</packaging>

    <modules>
        <!-- Extracted shared DDD building blocks -->
        <module>domain-commons</module>
        <!-- Microservice: Medical Sales Representative -->
        <module>medical-sales-rep-service</module>
        <!-- Microservice: Health Care Professional -->
        <module>healthcare-prof-service</module>
        <!-- Microservice: Visit & Visit Plan -->
        <module>visit-service</module>
        <!-- Microservice: Settlement -->
        <module>settlement-service</module>
        <!-- Microservice: Product Catalog -->
        <module>product-catalog-service</module>
        <!-- API Gateway -->
        <module>api-gateway</module>
        <!-- Service Registry (Eureka Server) -->
        <module>eureka-server</module>
        <!-- Identity Management (authentication, JWT issuance) -->
        <module>identity-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <start-class>com.das.cleanddd.application.DemoApplication</start-class>
        <log4j2.version>2.26.0</log4j2.version>
    </properties>

    <dependencies>
        <!-- JWT Support -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.3</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.3</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- OWASP A06 (Vulnerable Components): run with `mvn -Powasp dependency-check:check` -->
        <profile>
            <id>owasp</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.3</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                            </formats>
                            <ossIndexAnalyzerEnabled>false</ossIndexAnalyzerEnabled>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
