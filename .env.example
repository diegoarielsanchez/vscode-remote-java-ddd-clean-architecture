# Copy this file to .env and fill in all values before running docker compose.
# .env is git-ignored — never commit real secrets.

# Eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-min-32-chars-random-secret

# CORS (comma-separated origins for the gateway)
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

# Medical Sales Rep Service — PostgreSQL
MSR_DB_URL=jdbc:postgresql://postgres:5432/medicalsalesrep_db
MSR_PG_USERNAME=msr_user
MSR_PG_PASSWORD=change-me

# Healthcare Prof Service — PostgreSQL
HCP_DB_URL=jdbc:postgresql://postgres:5432/healthcare_db
HCP_PG_USERNAME=hcp_user
HCP_PG_PASSWORD=change-me

# Visit Service — MySQL
VISIT_DB_URL=jdbc:mysql://mysql:3306/visitdb?useSSL=true&requireSSL=true&serverTimezone=UTC
VISIT_DB_USERNAME=visit_user
VISIT_DB_PASSWORD=change-me

# Settlement Service — MySQL
SETTLEMENT_DB_URL=jdbc:mysql://mysql:3306/settlementdb?useSSL=true&requireSSL=true&serverTimezone=UTC
SETTLEMENT_DB_USERNAME=settlement_user
SETTLEMENT_DB_PASSWORD=change-me
