# Copy this file to .env and fill in all values before running docker compose.
# .env is git-ignored — never commit real secrets.

# Eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=change-me

# JWT
JWT_SECRET=change-me-min-32-chars-random-secret

# CORS (comma-separated origins for the gateway)
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# RabbitMQ
RABBITMQ_HOST=rabbitmq-ddd-clean
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change-me

# Medical Sales Rep Service — PostgreSQL
MSR_DB_URL=jdbc:postgresql://postgres-ddd-clean:5432/medicalsalesrep_db
MSR_PG_USERNAME=msr_user
MSR_PG_PASSWORD=change-me

# Healthcare Prof Service — PostgreSQL
HCP_DB_URL=jdbc:postgresql://postgres-ddd-clean:5432/healthcare_db
HCP_PG_USERNAME=hcp_user
HCP_PG_PASSWORD=change-me

# Visit Service — SQL Server
VISIT_DB_URL=jdbc:sqlserver://sqlserver-ddd-clean:1433;databaseName=visitdb;encrypt=false;trustServerCertificate=true
VISIT_DB_USERNAME=sa
VISIT_DB_PASSWORD=change-me

# Settlement Service — MySQL
SETTLEMENT_DB_URL=jdbc:mysql://mysql-ddd-clean:3306/settlementdb?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SETTLEMENT_DB_USERNAME=settlement_user
SETTLEMENT_DB_PASSWORD=change-me

# Product Catalog Service — PostgreSQL
CATALOG_DB_URL=jdbc:postgresql://postgres-ddd-clean:5432/productcatalog_db
CATALOG_PG_USERNAME=catalog_user
CATALOG_PG_PASSWORD=change-me

# Order Service — PostgreSQL
ORDER_DB_URL=jdbc:postgresql://postgres-ddd-clean:5432/order_db
ORDER_PG_USERNAME=order_user
ORDER_PG_PASSWORD=change-me

# Settlement UI — identity-service client credentials (used to obtain a JWT
# forwarded to the settlement-service API)
IDENTITY_CLIENT_USERNAME=user
IDENTITY_CLIENT_PASSWORD=change-me

# Observability — Grafana admin login (UI at http://localhost:3000)
GRAFANA_ADMIN_PASSWORD=change-me
