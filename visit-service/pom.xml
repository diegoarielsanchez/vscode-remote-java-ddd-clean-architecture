<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.das.visit</groupId>
    <artifactId>visit-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>visit-service</name>
    <packaging>pom</packaging>
    <description>Microservice: Visit and VisitPlan — domain, infra, and REST API</description>

    <modules>
        <module>visit-domain</module>
        <module>visit-infra</module>
        <module>visit-application</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <domain-commons.version>1.0.0-SNAPSHOT</domain-commons.version>
        <msr-domain.version>1.0.0-SNAPSHOT</msr-domain.version>
        <hcp-domain.version>1.0.0-SNAPSHOT</hcp-domain.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <spotbugs.version>4.10.3.0</spotbugs.version>
        <spotbugs.annotations.version>4.10.3</spotbugs.annotations.version>
        <findsecbugs.version>1.13.0</findsecbugs.version>
        <log4j2.version>2.26.0</log4j2.version>
    </properties>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.das.domain</groupId>
                <artifactId>domain-commons</artifactId>
                <version>${domain-commons.version}</version>
            </dependency>
            <dependency>
                <groupId>com.das.msr</groupId>
                <artifactId>msr-domain</artifactId>
                <version>${msr-domain.version}</version>
            </dependency>
            <dependency>
                <groupId>com.das.hcp</groupId>
                <artifactId>hcp-domain</artifactId>
                <version>${hcp-domain.version}</version>
            </dependency>
            <dependency>
                <groupId>com.das.visit</groupId>
                <artifactId>visit-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.das.visit</groupId>
                <artifactId>visit-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs.version}</version>
                <executions>
                    <execution>
                        <id>spotbugs-check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${findsecbugs.version}</version>
                        </plugin>
                    </plugins>
                    <failOnError>true</failOnError>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
