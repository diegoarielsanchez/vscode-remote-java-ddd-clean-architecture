// ─────────────────────────────────────────────────────────────────────────────
// Eureka Server — CI Pipeline
//
// Single-module Spring Cloud Netflix Eureka service registry (no domain/infra
// split). Every other microservice registers with and discovers peers through it.
//
// OWASP Top 10 controls embedded in pipeline:
//   A03 Injection                → SpotBugs + Find Security Bugs SAST scan.
//   A05 Security Misconfiguration→ Fail build on CRITICAL/HIGH Dependency-Check CVEs.
//   A06 Vulnerable Components    → OWASP Dependency-Check on every build.
// ─────────────────────────────────────────────────────────────────────────────
pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
        jdk   'JDK-25'
    }

    environment {
        MODULE          = 'eureka-server'
        IMAGE_NAME      = 'eureka-server'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        // ── OWASP Dependency-Check: fail on CVSS ≥ 7 (HIGH/CRITICAL) ─────────
        OWASP_FAIL_CVSS = '7'
    }

    stages {

        // ── Stage 1: Checkout ─────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── Stage 2: Tests ────────────────────────────────────────────────────
        stage('Test') {
            steps {
                sh "mvn -pl ${MODULE} -am test --no-transfer-progress"
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: "${MODULE}/target/surefire-reports/*.xml"
                }
            }
        }

        // ── Stage 3: SAST — SpotBugs + Find Security Bugs (OWASP A03) ────────
        stage('SAST — SpotBugs') {
            steps {
                sh """
                    mvn -pl ${MODULE} -am verify -DskipTests \\
                        --no-transfer-progress
                """
            }
            post {
                always {
                    dir('.') {
                        // Requires SpotBugs Jenkins plugin
                        recordIssues(tools: [spotBugs(pattern: '**/spotbugsXml.xml')])
                    }
                }
            }
        }

        // ── Stage 4: OWASP Dependency-Check (A06 Vulnerable Components) ──────
        // Scans all declared dependencies against the NVD CVE database.
        // Build fails if any dependency has a CVSS score ≥ OWASP_FAIL_CVSS.
        stage('OWASP Dependency-Check') {
            steps {
                script {
                    // NVD API key is optional — speeds up NVD updates but is not required.
                    // Register a Secret Text credential named 'nvd-api-key' in Jenkins to enable it.
                    // Free key: https://nvd.nist.gov/developers/request-an-api-key
                    def credentialAvailable = true
                    try {
                        withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                            credentialAvailable = true
                            sh """
                                mvn -pl ${MODULE} -am \\
                                    org.owasp:dependency-check-maven:check \\
                                    -Ddependency-check.skip=true \\
                                    -DfailBuildOnCVSS=${OWASP_FAIL_CVSS} \\
                                    -DnvdApiKey="\${NVD_API_KEY}" \\
                                    -DnvdApiDelay=500 \\
                                    -DretryCount=10 \\
                                    -DossIndexAnalyzerEnabled=false \\
                                    -Dformats=HTML,XML \\
                                    --no-transfer-progress
                            """
                        }
                    } catch (hudson.AbortException e) {
                        if (!credentialAvailable) {
                            echo "NVD API key credential 'nvd-api-key' not configured — running without API key (rate-limited)."
                            sh """
                                mvn -pl ${MODULE} -am \\
                                    org.owasp:dependency-check-maven:check \\
                                    -Ddependency-check.skip=true \\
                                    -DfailBuildOnCVSS=${OWASP_FAIL_CVSS} \\
                                    -DnvdApiDelay=6000 \\
                                    -DretryCount=10 \\
                                    -DossIndexAnalyzerEnabled=false \\
                                    -Dformats=HTML,XML \\
                                    --no-transfer-progress
                            """
                        } else {
                            throw e
                        }
                    }
                }
            }
            post {
                always {
                    dir('.') {
                        // Requires OWASP Dependency-Check Jenkins plugin
                        dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                    }
                }
            }
        }

        // ── Stage 5: Package ──────────────────────────────────────────────────
        stage('Package') {
            steps {
                sh "mvn -pl ${MODULE} -am package -DskipTests --no-transfer-progress"
            }
        }

        // ── Stage 6: Build Docker Image ───────────────────────────────────────
        stage('Build Docker Image') {
            when {
                expression { sh(script: 'which docker > /dev/null 2>&1', returnStatus: true) == 0 }
            }
            steps {
                sh """
                    docker build \
                        -f ${MODULE}/Dockerfile \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        -t ${IMAGE_NAME}:latest \
                        .
                """
            }
        }

        // ── Stage 7: Docker Image Scan (optional — requires Trivy on agent) ───
        // stage('Docker Image Scan — Trivy') {
        //     steps {
        //         sh """
        //             trivy image --exit-code 1 \
        //                 --severity HIGH,CRITICAL \
        //                 --no-progress \
        //                 ${IMAGE_NAME}:${IMAGE_TAG}
        //         """
        //     }
        // }

        // ── Stage 8: Push Docker Image (optional) ─────────────────────────────
        // stage('Push Docker Image') {
        //     steps {
        //         withCredentials([usernamePassword(
        //             credentialsId: 'docker-registry-credentials',
        //             usernameVariable: 'REGISTRY_USER',
        //             passwordVariable: 'REGISTRY_PASS'
        //         )]) {
        //             sh "docker login -u $REGISTRY_USER -p $REGISTRY_PASS <your-registry>"
        //             sh "docker push <your-registry>/${IMAGE_NAME}:${IMAGE_TAG}"
        //             sh "docker push <your-registry>/${IMAGE_NAME}:latest"
        //         }
        //     }
        // }

    }

    post {
        success {
            echo "Pipeline for ${env.IMAGE_NAME} passed all gates — build #${env.IMAGE_TAG}."
        }
        failure {
            echo "Pipeline for ${env.IMAGE_NAME} FAILED — review SAST / CVE reports above."
        }
        always {
            script {
                try {
                    cleanWs()
                } catch (Exception e) {
                    echo "Workspace cleanup skipped — no workspace context available: ${e.message}"
                }
            }
        }
    }
}
