// ─────────────────────────────────────────────────────────────────────────────
// Eureka Server — CI Pipeline
//
// Single-module Spring Cloud Netflix Eureka service registry (no domain/infra
// split). Every other microservice registers with and discovers peers through it.
//
// OWASP Top 10 controls embedded in pipeline:
//   A03 Injection                → SpotBugs + Find Security Bugs SAST scan.
//   A05 Security Misconfiguration→ Fail build on CRITICAL/HIGH Dependency-Check CVEs.
//   A06 Vulnerable Components    → OWASP Dependency-Check on every build.
// ─────────────────────────────────────────────────────────────────────────────
pipeline {
    agent any

    // Builds on push: GitHub delivers the event to Jenkins' /github-webhook/ endpoint.
    // Requires the GitHub plugin, a Jenkins URL GitHub can reach, and a repo webhook
    // pointing at <JENKINS_URL>/github-webhook/ (trailing slash required).
    triggers {
        githubPush()
    }

    tools {
        maven 'Maven-3.9'
        jdk   'JDK-25'
    }

    environment {
        MODULE          = 'eureka-server'
        IMAGE_NAME      = 'eureka-server'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"
        // ── OWASP Dependency-Check: fail on CVSS ≥ 7 (HIGH/CRITICAL) ─────────
        OWASP_FAIL_CVSS = '7'
    }

    stages {

        // ── Stage 1: Checkout ─────────────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── Stage 2: Tests ────────────────────────────────────────────────────
        stage('Test') {
            steps {
                sh "mvn -pl ${MODULE} -am test --no-transfer-progress"
            }
            post {
                always {
                    junit allowEmptyResults: false, testResults: "${MODULE}/target/surefire-reports/*.xml"
                }
            }
        }

        // ── Stage 3: SAST — SpotBugs + Find Security Bugs (OWASP A03) ────────
        stage('SAST — SpotBugs') {
            steps {
                sh """
                    mvn -pl ${MODULE} -am verify -DskipTests \\
                        --no-transfer-progress
                """
            }
            post {
                always {
                    dir('.') {
                        // Requires SpotBugs Jenkins plugin
                        recordIssues(tools: [spotBugs(pattern: '**/spotbugsXml.xml')])
                    }
                }
            }
        }

        // ── Stage 4: OWASP Dependency-Check (A06 Vulnerable Components) ──────
        // Scans all declared dependencies against the NVD CVE database.
        // Build fails if any dependency has a CVSS score ≥ OWASP_FAIL_CVSS.
        stage('OWASP Dependency-Check') {
            // Suppressions (false positives only, each with its reason) live in owasp-suppressions.xml at the
            // repo root. The service poms don't inherit the root pom's `owasp` profile, so the plugin version
            // and its settings are passed here.
            steps {
                script {
                    // Scans with the NVD API key when the 'nvd-api-key' Secret Text credential exists
                    // (free key: https://nvd.nist.gov/developers/request-an-api-key), otherwise without it.
                    // nvdApiDelay: without a key NVD allows ~5 req/30 s → 6 000 ms is safe;
                    //              with a key the limit is 50 req/30 s → 500 ms is fine.
                    // retryCount:  retry up to 10 times before failing on persistent 429s.
                    //
                    // A run that finds a dependency with CVSS ≥ OWASP_FAIL_CVSS fails the stage straight away.
                    // Only a run that failed for another reason (missing or revoked key, NVD outage) is
                    // repeated without the key.
                    def scan = { String nvdArgs ->
                        // POSIX sh has no pipefail: the exit code is saved to a file so `tee` can stream the log.
                        sh(returnStatus: true, script: """
                            { mvn -pl ${MODULE} -am \\
                                org.owasp:dependency-check-maven:12.1.3:check \\
                                -Ddependency-check.skip=false \\
                                -DsuppressionFile="\${WORKSPACE}/owasp-suppressions.xml" \\
                                -DassemblyAnalyzerEnabled=false \\
                                -DfailBuildOnCVSS=${OWASP_FAIL_CVSS} \\
                                ${nvdArgs} \\
                                -DretryCount=10 \\
                                -DossindexAnalyzerEnabled=false \\
                                -Dformats=HTML,XML \\
                                --no-transfer-progress \\
                                && echo 0 > dependency-check.status \\
                                || echo \$? > dependency-check.status; } 2>&1 | tee dependency-check.log
                            exit \$(cat dependency-check.status)
                        """)
                    }
                    // The plugin's own message when failBuildOnCVSS is exceeded.
                    def foundVulnerabilities = {
                        readFile('dependency-check.log')
                            .contains('identified with vulnerabilities that have a CVSS score greater than or equal to')
                    }

                    int status = -1
                    try {
                        withCredentials([string(credentialsId: 'nvd-api-key', variable: 'NVD_API_KEY')]) {
                            // Single quotes: the shell expands the key, so it never enters the Groovy string.
                            status = scan('-DnvdApiKey="$NVD_API_KEY" -DnvdApiDelay=500')
                        }
                    } catch (hudson.AbortException e) {
                        // withCredentials throws this when the credential does not exist.
                        echo "NVD API key unavailable (${e.message}) — scanning without it (rate-limited)."
                    }
                    if (status > 0 && !foundVulnerabilities()) {
                        echo "Dependency-Check with the NVD API key failed (exit ${status}) — retrying without it (rate-limited)."
                    }
                    if (status == -1 || (status > 0 && !foundVulnerabilities())) {
                        status = scan('-DnvdApiDelay=6000')
                    }
                    if (status != 0) {
                        error(foundVulnerabilities()
                            ? "Dependencies with CVSS ≥ ${OWASP_FAIL_CVSS} found — see the Dependency-Check report."
                            : "Dependency-Check could not complete (exit ${status}) — see the log above.")
                    }
                }
            }
            post {
                always {
                    dir('.') {
                        // Requires OWASP Dependency-Check Jenkins plugin
                        dependencyCheckPublisher pattern: '**/dependency-check-report.xml'
                    }
                }
            }
        }

        // ── Stage 5: Package ──────────────────────────────────────────────────
        stage('Package') {
            steps {
                sh "mvn -pl ${MODULE} -am package -DskipTests --no-transfer-progress"
            }
        }

        // ── Stage 6: Build Docker Image ───────────────────────────────────────
        // Build context is this service's own directory (single-module, no
        // dependency on domain-commons, so no extra build context is needed).
        stage('Build Docker Image') {
            when {
                expression { sh(script: 'which docker > /dev/null 2>&1', returnStatus: true) == 0 }
            }
            steps {
                sh """
                    DOCKER_BUILDKIT=1 docker build \
                        -f ${MODULE}/Dockerfile \
                        -t ${IMAGE_NAME}:${IMAGE_TAG} \
                        -t ${IMAGE_NAME}:latest \
                        ${MODULE}
                """
            }
        }

        // ── Stage 7: Docker Image Scan (optional — requires Trivy on agent) ───
        // stage('Docker Image Scan — Trivy') {
        //     steps {
        //         sh """
        //             trivy image --exit-code 1 \
        //                 --severity HIGH,CRITICAL \
        //                 --no-progress \
        //                 ${IMAGE_NAME}:${IMAGE_TAG}
        //         """
        //     }
        // }

        // ── Stage 8: Push Docker Image (optional) ─────────────────────────────
        // stage('Push Docker Image') {
        //     steps {
        //         withCredentials([usernamePassword(
        //             credentialsId: 'docker-registry-credentials',
        //             usernameVariable: 'REGISTRY_USER',
        //             passwordVariable: 'REGISTRY_PASS'
        //         )]) {
        //             sh "docker login -u $REGISTRY_USER -p $REGISTRY_PASS <your-registry>"
        //             sh "docker push <your-registry>/${IMAGE_NAME}:${IMAGE_TAG}"
        //             sh "docker push <your-registry>/${IMAGE_NAME}:latest"
        //         }
        //     }
        // }

    }

    post {
        success {
            echo "Pipeline for ${env.IMAGE_NAME} passed all gates — build #${env.IMAGE_TAG}."
        }
        failure {
            echo "Pipeline for ${env.IMAGE_NAME} FAILED — review SAST / CVE reports above."
        }
        always {
            script {
                try {
                    cleanWs()
                } catch (Exception e) {
                    echo "Workspace cleanup skipped — no workspace context available: ${e.message}"
                }
            }
        }
    }
}
