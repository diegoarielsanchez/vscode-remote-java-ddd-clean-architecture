{
  "name": "backoffice-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 5175",
    "build": "next build && cp -r .next/static .next/standalone/.next/",
    "start": "HOSTNAME=localhost PORT=5175 node --import ./scripts/client-ip.mjs .next/standalone/server.js",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --test 'src/**/*.test.ts'",
    "smoke": "npm run build && node e2e/smoke.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
