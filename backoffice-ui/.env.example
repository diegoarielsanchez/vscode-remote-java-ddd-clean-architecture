# Gateway the BFF calls (server side only; never sent to the browser).
GATEWAY_URL=http://localhost:8080

# Encrypts the session cookie. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=

# ROLE_USER account used only to fill the shared ISR cache (product master data, specialties).
# Never an admin or agent account.
CATALOG_SERVICE_USERNAME=
CATALOG_SERVICE_PASSWORD=

# Signs POST /bff/revalidate calls. Leave blank to disable that endpoint.
REVALIDATE_SECRET=

# Sign out after this many minutes without a page load.
IDLE_TIMEOUT_MINUTES=15

# Secure + __Host- cookie, HSTS and upgrade-insecure-requests. Default: on in production.
# Set to false only for plain-http use on a host other than localhost.
# COOKIE_SECURE=true

# Reverse proxies in front of this app that append to X-Forwarded-For (0 = browsers connect directly).
TRUSTED_PROXY_HOPS=0
