# Rendered by the nginx image at startup (envsubst): ${GATEWAY_URL}, ${API_ORIGIN}.
# Same-origin deployment: the PWA and the API share one origin, so no CORS is involved and the
# CSP connect-src stays 'self'. Terminate TLS in front of this container (or add a 443 server).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    client_max_body_size 11m;   # invoice uploads are capped at 10 MB by the backend

    set $api_origin "${API_ORIGIN}";

    # ── API → gateway ─────────────────────────────────────────────────────────────
    location ~ ^/(api|auth)/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The browser's Origin is this site; the gateway would treat it as a cross-origin call.
        # Safe because auth is a bearer token (no cookies → no CSRF).
        proxy_set_header Origin "";
        add_header Cache-Control "no-store" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ── Service worker & manifest: always revalidate so updates reach users ─────
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ── Hashed build assets: cache forever ─────────────────────────────────────
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # ── SPA fallback ───────────────────────────────────────────────────────────
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/security-headers.conf;
    }
}
