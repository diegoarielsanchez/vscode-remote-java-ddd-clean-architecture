# Gateway the dev/preview server proxies /api and /auth to.
GATEWAY_URL=http://localhost:8080

# Base URL the app calls. "/" = same origin (recommended: dev proxy / nginx reverse proxy).
# For a separate API origin use e.g. https://api.yourdomain.com/ and add the PWA origin to the
# gateway CORS allow-list. Production builds refuse plain http except for localhost.
VITE_API_BASE_URL=/

# Sign the user out after this many minutes without interaction.
VITE_IDLE_TIMEOUT_MINUTES=15
